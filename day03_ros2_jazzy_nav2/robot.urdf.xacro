<?xml version="1.0"?>
<!--
  robot.urdf.xacro: Differential-Drive Autonomous Mobile Robot (AMR)
  Kinematic model defining chassis mass, inertial moments, actuator joints,
  and sensor coordinate frames for ROS 2 Gazebo simulation.
-->
<robot name="diff_drive_amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================================================================== -->
  <!-- 1. Physical Parameters (Metric SI Units)                              -->
  <!-- ===================================================================== -->
  <xacro:property name="chassis_length" value="0.30"/> <!-- 30 cm -->
  <xacro:property name="chassis_width"  value="0.25"/> <!-- 25 cm -->
  <xacro:property name="chassis_height" value="0.10"/> <!-- 10 cm -->
  <xacro:property name="chassis_mass"   value="2.50"/> <!-- 2.5 kg -->

  <xacro:property name="wheel_radius"   value="0.045"/> <!-- 45 mm -->
  <xacro:property name="wheel_width"    value="0.025"/> <!-- 25 mm -->
  <xacro:property name="wheel_mass"     value="0.20"/>  <!-- 200 g -->
  <xacro:property name="track_width"    value="0.28"/>  <!-- 28 cm wheel-to-wheel -->

  <xacro:property name="caster_radius"  value="0.020"/> <!-- 20 mm -->
  <xacro:property name="caster_mass"    value="0.08"/>  <!-- 80 g -->

  <!-- ===================================================================== -->
  <!-- 2. Inertial Macro Helpers (Rigid-Body Dynamics)                       -->
  <!-- ===================================================================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12.0)*(y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12.0)*(x*x + z*z)}" iyz="0.0"
               izz="${(m/12.0)*(x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12.0)*(3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12.0)*(3*r*r + h*h)}" iyz="0.0"
               izz="${(m/2.0)*(r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- ===================================================================== -->
  <!-- 3. Base Footprint & Main Chassis Link                                 -->
  <!-- ===================================================================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="chassis_blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
  </link>

  <!-- ===================================================================== -->
  <!-- 4. Left & Right Actuated Traction Wheels                              -->
  <!-- ===================================================================== -->
  <xacro:macro name="wheel" params="prefix y_offset">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="tire_black">
          <color rgba="0.15 0.15 0.15 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 ${y_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left"  y_offset="${track_width/2}"/>
  <xacro:wheel prefix="right" y_offset="${-track_width/2}"/>

  <!-- ===================================================================== -->
  <!-- 5. Front Passive Caster Wheel (Frictionless Ground Support)           -->
  <!-- ===================================================================== -->
  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="caster_metal">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${caster_mass}"/>
      <inertia ixx="${(2.0/5.0)*caster_mass*caster_radius*caster_radius}" ixy="0" ixz="0"
               iyy="${(2.0/5.0)*caster_mass*caster_radius*caster_radius}" iyz="0"
               izz="${(2.0/5.0)*caster_mass*caster_radius*caster_radius}"/>
    </inertial>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="${chassis_length/2 - caster_radius} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================================== -->
  <!-- 6. Planar 2D LiDAR Sensor Mount (laser_frame)                         -->
  <!-- ===================================================================== -->
  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.040"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.040"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.120" r="0.035" h="0.040"/>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.08 0 ${chassis_height + 0.02}" rpy="0 0 0"/>
  </joint>

</robot>
